# Telegram Bot Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Bot username without @ (used for deep links & inline challenge cards)
BOT_USERNAME=your_bot_username

# Public HTTPS URL for the Telegram Mini App (e.g. from ngrok, cloudflared, or your domain)
# Leave empty during pure local bot testing; Mini App server still runs on http://localhost:8000
WEBAPP_URL=

# Mini App Web Server Settings
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Admin user settings (comma-separated Telegram user IDs)
ADMIN_USER_IDS=
ADMIN_SECRET=admin123
